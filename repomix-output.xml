  useEffect(() => {
    if (!userId) {
      Alert.alert('Lỗi', 'Không tìm thấy thông tin người dùng');
      router.back();
      return;
    }

    const fetchUserData = async () => {
      try {
        const response = await getUserProfile(userId);
        setUserData(response);
      } catch (error) {
        // Error fetching user data
      } finally {
        setLoading(false);
      }
    };

    fetchUserData();
