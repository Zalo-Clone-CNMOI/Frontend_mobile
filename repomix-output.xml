        setGroupMembers(data.members);
      }
    } catch (error) {
      console.error('Failed to fetch group members:', error);
    } finally {
      setLoadingMembers(false);
    }
  };

  // ✅ FIX 4: Chỉ fetch group members, friends đến từ realtime store
  useEffect(() => {
    fetchGroupMembers();
  }, []);

