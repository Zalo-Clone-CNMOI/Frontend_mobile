import { styles } from '../styles';

interface ComposerInputProps {
  value: string;
  onChangeText: (text: string) => void;
  onSend: () => void;
  onTypingStart?: () => void;
  onTypingStop?: () => void;
  canSend: boolean;
  onPickImage: () => void;
  theme: any;
}

export const ComposerInput: React.FC<ComposerInputProps> = ({
  value,
  onChangeText,
  onSend,
  onTypingStart,
  onTypingStop,
  canSend,
  onPickImage,
  theme,
}) => {
  const { t } = useTranslation();
