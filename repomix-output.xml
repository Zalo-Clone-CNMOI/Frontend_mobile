                      { color: selectedFriends.size > 0 ? '#fff' : theme.colors.icon },
                    ]}
                  >
                    {t('group_errors.send_invites') || 'Send Invites'}
                  </Text>
                </View>
              )}
            </TouchableOpacity>
          </View>
        </TouchableOpacity>
      </Pressable>
    </Modal>
  );
}

