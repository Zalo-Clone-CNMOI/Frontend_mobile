interface TabBarProps {
  activeTab: 'active' | 'closed';
  onTabChange: (tab: 'active' | 'closed') => void;
  theme: any;
}

export const TabBar: React.FC<TabBarProps> = ({ activeTab, onTabChange, theme }) => {
