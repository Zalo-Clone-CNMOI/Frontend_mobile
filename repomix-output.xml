                {isExpanded ? <ChevronDown size={20} color={theme.colors.text} /> : <ChevronRight size={20} color={theme.colors.text} />}
              </View>
            </TouchableOpacity>

            {isExpanded && (
              <View style={[styles.langBoxContainer, { backgroundColor: theme.colors.background }]}>
                <LanguageOption
