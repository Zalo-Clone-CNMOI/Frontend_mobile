# Backend host (single source of truth for all services)
EXPO_PUBLIC_API_HOST=18.138.217.102

# Service ports
EXPO_PUBLIC_BFF_PORT=3000
EXPO_PUBLIC_API_PORT=5000
EXPO_PUBLIC_SOCKET_PORT=3001
EXPO_PUBLIC_SSO_PORT=5001

# Avatar placeholder URL (default avatar when user has no avatar)
EXPO_PUBLIC_AVATAR_BASE_URL=https://i.pravatar.cc/150

# S3 configuration
EXPO_PUBLIC_S3_BUCKET=zalo-bucket-clone
EXPO_PUBLIC_S3_REGION=ap-southeast-1

# Media upload configuration
EXPO_PUBLIC_S3_UPLOAD_TIMEOUT=60000
EXPO_PUBLIC_PRESIGN_UPLOAD_TIMEOUT=10000
EXPO_PUBLIC_CONFIRM_UPLOAD_TIMEOUT=90000
EXPO_PUBLIC_PRESIGN_DOWNLOAD_TIMEOUT=15000
EXPO_PUBLIC_MAX_FILE_SIZE_IMAGE=52428800
EXPO_PUBLIC_MAX_FILE_SIZE_VIDEO=104857600
EXPO_PUBLIC_MAX_FILE_SIZE_AUDIO=10485760
EXPO_PUBLIC_MAX_FILE_SIZE_DOCUMENT=10485760

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# EAS Project ID
EXPO_PUBLIC_EAS_PROJECT_ID=9ec780b4-cf87-4dd4-8f4d-4ce0f844d864