# Expo mobile app reads EXPO_PUBLIC_* only (NEXT_PUBLIC_* is ignored).
EXPO_PUBLIC_API_HOST=18.138.217.102
EXPO_PUBLIC_API_PORT=5000
EXPO_PUBLIC_SOCKET_PORT=3001
EXPO_PUBLIC_SSO_PORT=5001

# Optional — only if you run a separate BFF on this port
EXPO_PUBLIC_BFF_PORT=3000

# Optional — override the Zai assistant bot id (defaults to the value below)
EXPO_PUBLIC_ZAI_BOT_ID=00000000-0000-4000-8000-0000000000a1

EXPO_PUBLIC_S3_BUCKET=zalo-bucket-clone
EXPO_PUBLIC_S3_REGION=ap-southeast-1

EXPO_PUBLIC_S3_UPLOAD_TIMEOUT=60000
EXPO_PUBLIC_PRESIGN_UPLOAD_TIMEOUT=10000
EXPO_PUBLIC_CONFIRM_UPLOAD_TIMEOUT=90000
EXPO_PUBLIC_PRESIGN_DOWNLOAD_TIMEOUT=15000

# Firebase (Expo)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
